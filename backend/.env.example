# Server & Network Configuration
PORT=5000
NODE_ENV=development

# Database Connection (MongoDB)
MONGO_URI=mongodb://localhost:27017/ehr_db

# Security & Authentication Secret
JWT_SECRET=replace_with_a_secure_random_64_char_secret_key

# Google Gemini API (for AI Ambient Clinical Scribe & Vitals Extraction)
GEMINI_API_KEY=your_google_gemini_api_key_here

# Cloudinary Storage Configuration (Optional - for Medical File/Scan Uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
